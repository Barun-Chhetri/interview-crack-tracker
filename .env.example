# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://barun:YOUR_DB_PASSWORD@192.168.68.61:5433/barun_db?schema=public"

# Explicit Database Credentials
DB_HOST="192.168.68.61"
DB_PORT=5433
DB_NAME="barun_db"
DB_USERNAME="barun"
DB_PASSWORD="YOUR_DB_PASSWORD"

# Authentication Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
AUTH_COOKIE_NAME="auth_token"

# Optional Email Configuration for Accountability Reports
# Configure either Resend API Key OR SMTP Credentials:
# RESEND_API_KEY="re_123456789"
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.com"
# SMTP_PASS="secret_password"
# SMTP_FROM="Interview Tracker <noreply@yourdomain.com>"
