# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://barun:YOUR_DB_PASSWORD@192.168.68.61:5433/barun_db?schema=public"

# Explicit Database Credentials
DB_HOST="192.168.68.61"
DB_PORT=5433
DB_NAME="barun_db"
DB_USERNAME="barun"
DB_PASSWORD="YOUR_DB_PASSWORD"

# Authentication Security
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
AUTH_COOKIE_NAME="auth_token"

# Email Configuration for Accountability & Analysis Reports
# Choose either Resend API Key OR Standard SMTP (e.g. Gmail / Outlook / Mailgun):

# Option A: Resend (Recommended - 100 free emails/day, zero domain setup required)
# RESEND_API_KEY="re_123456789abcdef"

# Option B: Gmail SMTP (Requires 16-character Google App Password)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# SMTP_FROM="Interview Tracker <your-email@gmail.com>"

# Option C: Development / Test Mode (Uses free Ethereal web mailboxes for instant previews)
# EMAIL_TEST_MODE="false"

